# BasicHotFlow

main: kit: flow: BasicHotFlow:
{
  entity: "hot",
  kind: "basic",
  name: "BasicHotFlow",
  step: [
    {
      i: {
        ref: "hot_ref01",
        srcdatavar: "hot_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "hot01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-hot_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicHotFlow"
}