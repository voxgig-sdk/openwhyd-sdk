                        "type": "string"
                      },
                      "eId": {
                        "description": "External ID (platform identifier)",
                        "type": "string"
                      },
                      "img": {
                        "description": "Track image URL",
                        "type": "string"
                      },
                      "lov": {
                        "description": "User IDs who liked this post",
                        "items": {
